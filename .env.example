# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql+psycopg://devsupport:change-me@localhost:5432/devsupport

# Model provider (required from Week 05)
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Development-only identity stubs (introduced in Week 04)
DEV_AUTH_TOKEN_ALICE=replace-with-a-local-only-value
DEV_AUTH_TOKEN_BOB=replace-with-a-local-only-value

# Agent execution limits (introduced in Week 07)
AGENT_MAX_MODEL_ROUNDS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_RUN_DEADLINE_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=3
